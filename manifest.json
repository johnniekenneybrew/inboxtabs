{
  "manifest_version": 3,
  "name": "Gmail Label Tabs",
  "version": "2.0",
  "description": "Adds a pinned tab bar to Gmail for instant label navigation.",

  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://mail.google.com/*"
  ],

  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Gmail Label Tabs"
  }
}
